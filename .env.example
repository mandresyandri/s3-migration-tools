# Copier en .env et remplir (le .env est ignoré par git)

# --- Source : le S3 actuel ---
SRC_ENDPOINT_URL=https://...
SRC_ACCESS_KEY_ID=
SRC_SECRET_ACCESS_KEY=
SRC_REGION=us-east-1
SRC_BUCKET=
# SRC_ADDRESSING_STYLE=path

# --- Destination : Cellar Clever Cloud ---
# Valeurs dans l'onglet "Information" de l'add-on Cellar (CELLAR_ADDON_HOST, KEY_ID, KEY_SECRET)
DST_ENDPOINT_URL=https://cellar-c2.services.clever-cloud.com
DST_ACCESS_KEY_ID=
DST_SECRET_ACCESS_KEY=
DST_REGION=us-east-1
DST_BUCKET=
